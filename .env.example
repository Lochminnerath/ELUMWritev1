# Pick one backend. With none set, Write runs on a local API and data stays in the browser.

# Supabase (see supabase/README.md). The anon key is public by design; never put the service role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: the parent domain every ELUM service shares (such as .elum.services). One sign-in then covers them all.
# Only works on subdomains of a domain you own; *.netlify.app sites cannot share cookies.
VITE_ELUM_COOKIE_DOMAIN=

# ELUM Account: one sign-in for every ELUM app, and where profile, picture and privacy changes happen.
# Needs the Supabase settings above and the account-handoff function (see ELUMAccountsV1 docs/SIGN-IN.md).
VITE_ELUM_ACCOUNT_URL=https://accountsbyelum.netlify.app
# Where the other apps live (these are the defaults).
# VITE_ELUM_WRITE_URL=https://writebyelum.netlify.app
# VITE_ELUM_TYPE_URL=https://typebyelum.netlify.app

# Or the ELUM API over HTTPS (see docs/API.md), for example https://api.elum.services/v1
VITE_ELUM_API_URL=
