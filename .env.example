# Pick one backend. With none set, Write runs on a local API and data stays in the browser.

# Supabase (see supabase/README.md). The anon key is public by design; never put the service role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: the parent domain every ELUM service shares (such as .elum.example). One sign-in then covers them all.
VITE_ELUM_COOKIE_DOMAIN=

# Or the ELUM API over HTTPS (see docs/API.md), for example https://api.elum.example/v1
VITE_ELUM_API_URL=
